{
  "name": "pasi-mandarim",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test:e2e": "playwright test",
    "audio:web-catalog": "node scripts/sync-web-audio-catalog.mjs",
    "audio:sync": "node scripts/sync-human-audio.mjs",
    "audio:sync:force": "node scripts/sync-human-audio.mjs --force",
    "audio:tts:catalog": "node scripts/sync-tts-audio.mjs --catalog-only",
    "audio:tts:sync": "node scripts/sync-tts-audio.mjs",
    "tone-pairs:sync": "node scripts/sync-tone-pair-audio.mjs",
    "tone-pairs:sync:force": "node scripts/sync-tone-pair-audio.mjs --force",
    "phrases:sync": "node scripts/sync-sentence-audio.mjs",
    "phrases:fixture": "node scripts/generate-sentence-fixture.mjs",
    "radicals:sync": "node scripts/sync-radicals.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "typescript": "6.0.2",
    "vue-tsc": "3.3.11"
  }
}
